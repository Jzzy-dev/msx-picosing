+/*
+ * hcd_rp2_iso.h - isochronous IN streaming for the RP2040/RP2350 TinyUSB host
+ *
+ * Added for the PicoVerse SingStar microphone driver (Jzzy, 2026).
+ *
+ * TinyUSB's RP2 host controller driver has no isochronous support. This
+ * extension streams one isochronous IN endpoint through one of the
+ * hardware "interrupt" endpoint slots. Every received packet is handed to
+ * a callback straight from the USB interrupt and the buffer is re-armed at
+ * once, so no packet waits for tuh_task().
+ *
+ * Usage: open the endpoint with tuh_edpt_open() first (that programs the
+ * slot), then call hcd_rp2_iso_start(). Only one stream at a time.
+ */
+#ifndef HCD_RP2_ISO_H_
+#define HCD_RP2_ISO_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Flags for hcd_rp2_iso_start()
+#define HCD_RP2_ISO_PID_TOGGLE  0x01u  // alternate DATA0/DATA1 (default: DATA0 always, as USB full-speed iso)
+#define HCD_RP2_ISO_LAST        0x02u  // set the LAST bit in buffer control
+
+// Called from the USB IRQ for every completed buffer.
+// data/len: received bytes (len 0 = buffer completed without data)
+// frame: current USB frame number (SOF counter)
+typedef void (*hcd_rp2_iso_rx_cb_t)(uint8_t const* data, uint16_t len, uint16_t frame);
+
+bool hcd_rp2_iso_start(uint8_t dev_addr, uint8_t ep_addr, uint16_t buflen, uint8_t flags, hcd_rp2_iso_rx_cb_t cb);
+void hcd_rp2_iso_stop(void);
+bool hcd_rp2_iso_kick(void);     // re-arm if the buffer is not armed (watchdog); true if re-armed
+bool hcd_rp2_iso_active(void);
+
+// Diagnostics (incremented in the IRQ)
+extern volatile uint32_t hcd_rp2_iso_seq_errors;
+extern volatile uint32_t hcd_rp2_iso_rx_timeouts;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

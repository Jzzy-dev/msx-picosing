+//--------------------------------------------------------------------+
+// Isochronous IN streaming (PicoVerse SingStar extension, see hcd_rp2_iso.h)
+//--------------------------------------------------------------------+
+#include "hcd_rp2_iso.h"
+
+static struct hw_endpoint* volatile _iso_ep = NULL;
+static hcd_rp2_iso_rx_cb_t _iso_cb = NULL;
+static uint8_t  _iso_flags = 0;
+static uint16_t _iso_len = 0;
+volatile uint32_t hcd_rp2_iso_seq_errors = 0;
+volatile uint32_t hcd_rp2_iso_rx_timeouts = 0;
+
+static void __tusb_irq_path_func(_iso_arm)(struct hw_endpoint* ep)
+{
+  uint32_t bc = (uint32_t) _iso_len | USB_BUF_CTRL_AVAIL | USB_BUF_CTRL_SEL;
+  if ( (_iso_flags & HCD_RP2_ISO_PID_TOGGLE) && ep->next_pid ) bc |= USB_BUF_CTRL_DATA1_PID;
+  ep->next_pid ^= 1u;
+  if ( _iso_flags & HCD_RP2_ISO_LAST ) bc |= USB_BUF_CTRL_LAST;
+  // write everything but AVAIL first, then AVAIL (datasheet "concurrent access")
+  *ep->buffer_control = bc & ~USB_BUF_CTRL_AVAIL;
+  busy_wait_at_least_cycles(12);
+  *ep->buffer_control = bc;
+}
+
+static void __tusb_irq_path_func(_iso_handle)(uint32_t bit, struct hw_endpoint* ep)
+{
+  usb_hw_clear->buf_status = bit;
+  uint32_t const bc = *ep->buffer_control;
+  uint16_t const len = (bc & USB_BUF_CTRL_FULL) ? (uint16_t) (bc & USB_BUF_CTRL_LEN_MASK) : 0;
+  if ( _iso_cb ) _iso_cb((uint8_t const*) ep->hw_data_buf, len, (uint16_t) usb_hw->sof_rd);
+  if ( _iso_ep == ep ) _iso_arm(ep);
+}
+
+bool hcd_rp2_iso_start(uint8_t dev_addr, uint8_t ep_addr, uint16_t buflen, uint8_t flags, hcd_rp2_iso_rx_cb_t cb)
+{
+  struct hw_endpoint* ep = get_dev_ep(dev_addr, ep_addr);
+  if ( !ep || ep == &epx || !ep->configured ) return false;
+  if ( buflen == 0 || buflen > 64 ) buflen = 64;   // interrupt-endpoint slots have a 64 byte buffer
+
+  irq_set_enabled(USBCTRL_IRQ, false);
+  _iso_len   = buflen;
+  _iso_flags = flags;
+  _iso_cb    = cb;
+  ep->next_pid = 0;
+  ep->active   = true;   // keeps the TinyUSB core from using this endpoint
+  _iso_ep    = ep;
+  _iso_arm(ep);
+  irq_set_enabled(USBCTRL_IRQ, true);
+  return true;
+}
+
+static void _iso_release(struct hw_endpoint* ep)
+{
+  usb_hw_clear->int_ep_ctrl = (1u << (ep->interrupt_num + 1));
+  usb_hw->int_ep_addr_ctrl[ep->interrupt_num] = 0;
+  ep->configured = false;
+  *ep->endpoint_control = 0;
+  *ep->buffer_control = 0;
+  hw_endpoint_reset_transfer(ep);
+}
+
+void hcd_rp2_iso_stop(void)
+{
+  irq_set_enabled(USBCTRL_IRQ, false);
+  struct hw_endpoint* ep = _iso_ep;
+  _iso_ep = NULL;
+  _iso_cb = NULL;
+  if ( ep ) _iso_release(ep);
+  irq_set_enabled(USBCTRL_IRQ, true);
+}
+
+bool hcd_rp2_iso_kick(void)
+{
+  bool kicked = false;
+  irq_set_enabled(USBCTRL_IRQ, false);
+  struct hw_endpoint* ep = _iso_ep;
+  if ( ep && !(*ep->buffer_control & USB_BUF_CTRL_AVAIL) )
+  {
+    _iso_arm(ep);
+    kicked = true;
+  }
+  irq_set_enabled(USBCTRL_IRQ, true);
+  return kicked;
+}
+
+bool hcd_rp2_iso_active(void)
+{
+  return _iso_ep != NULL;
+}
